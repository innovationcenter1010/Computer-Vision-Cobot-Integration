# =============================================================
# .gitignore
# (Note: .dockerignore is its own file — this one is for git.)
# =============================================================

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- colcon workspace artifacts (never commit build output) ---
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# --- Legacy C++ build output ---
build/
cmake-build-debug/
cmake-build-release/

# --- IDE / local tooling ---
.vscode/

# --- Model weights (large binaries; vision_workspace mount is the source) ---
*.pt
*.engine

# --- Per-machine calibration (written by /task/calibrate into the
#     bind-mounted config dir; belongs to this robot+camera, not the repo) ---
ros2_ws/src/cobot_bringup/config/calibration.yaml

# --- Vision workspace runtime output ---
vision_workspace/operation/inbox/
vision_workspace/operation/debug_images/
vision_workspace/operation/results/
vision_workspace/operation/captures/
vision_workspace/models/training_runs/

# --- Per-camera intrinsics (written by the streamer from the camera SDK,
#     relayed as CameraInfo; belongs to this camera, not the repo) ---
vision_workspace/operation/camera_intrinsics.json

# --- Misc ---
outputs/
*.svg
