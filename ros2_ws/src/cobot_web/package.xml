<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cobot_web</name>
  <version>0.1.0</version>
  <description>
    Browser ⇄ ROS-graph bridge. Runs the legacy FastAPI app (templates,
    static files, websocket) alongside rclpy: browser commands become
    service calls, camera topics are throttled to JPEG-over-websocket, and
    vision/cobot feedback is forwarded to connected clients.
  </description>
  <maintainer email="innovationcenter1010@gmail.com">james-t-smith</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>cobot_interfaces</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- fastapi / uvicorn / jinja2: pip-only — installed in the Docker image -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
