<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cobot_interfaces</name>
  <version>0.1.0</version>
  <description>
    Message and service contracts for the cobot bin-picking stack.
    Pixel-space detections (yolo_node) vs robot-space targets (localization_node)
    are deliberately separate types: the cobot never sees pixels, YOLO never
    sees millimeters. See docs/ros2_architecture.md.
  </description>
  <maintainer email="innovationcenter1010@gmail.com">james-t-smith</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <depend>std_msgs</depend>
  <!-- required by rosidl for the .action files -->
  <depend>action_msgs</depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
