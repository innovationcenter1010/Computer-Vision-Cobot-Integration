# Re-express a cartesian pose (mm / deg, robot base frame) taught with tool
# file `from_tool` as the same physical arm configuration seen through tool
# file `to_tool`, using the CONTROLLER's kinematics. Read-only: nothing moves,
# nothing is written. Used to migrate remembered positions when the active
# tool changes.
#
# Path: cart(from_tool) --IK (Delta, seeded with the current joints)--> joints
#       --FK with toolNumber=to_tool--> cart(to_tool).
# If joints_deg has 6 values (S L U R B T) the IK step is skipped and those
# joints are FK'd directly - the canonical, configuration-free storage.
float64 x
float64 y
float64 z
float64 rx
float64 ry
float64 rz
int32 from_tool -1        # -1 = active tool
int32 to_tool -1          # -1 = active tool
float64[] joints_deg      # optional, 6 values -> skip IK
---
bool success
int32 status_code         # 0 ok; 1 not connected; 2 invalid request; else YMConnect code
string message
float64 x
float64 y
float64 z
float64 rx
float64 ry
float64 rz
float64[] joints_deg      # S L U R B T the returned pose corresponds to (store these)
int32 from_tool           # resolved values
int32 to_tool
