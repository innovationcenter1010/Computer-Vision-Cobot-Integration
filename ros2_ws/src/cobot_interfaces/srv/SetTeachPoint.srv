# cobot_operation: overwrite points.<key>[index] of trajectories.json with an
# EDITED pose (developer dashboard). Unlike SaveTeachPoint (which snapshots the
# live /cobot/state pose + joints), the values here were typed by a person, so
# joints_deg is cleared — teach or convert the point to restore joints.
# tool_number -1 = the active tool; every other stored point must already be
# expressed in the resolved tool's frame.
string key
int32 index 0
float64 x
float64 y
float64 z
float64 rx
float64 ry
float64 rz
int32 tool_number -1
---
bool success
string message
int32 tool_number         # the tool file the pose was stored in
