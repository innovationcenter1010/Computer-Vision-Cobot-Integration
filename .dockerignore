# =============================================================
# Keep the build context lean. The ROS2 Dockerfile only COPYs
# ros2_ws/src and docker/entrypoint.sh — everything else is noise.
# =============================================================

# --- Version control ---
.git
.gitmodules
.gitignore

# --- IDE / local tooling ---
.vscode
cmake-build-debug
cmake-build-release

# --- colcon build output (builder stage builds fresh) ---
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
build/

# --- Legacy application + old C++ tree (motoman_cpp package has its own copy) ---
legacy/
cpp/
app/
docs/

# --- Model weights: NEVER baked — vision_workspace is bind-mounted ---
*.pt
vision_workspace/

# --- Python cache ---
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# --- Misc ---
*.svg
datasets
outputs
