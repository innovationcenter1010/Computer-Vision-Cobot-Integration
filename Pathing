def serpentine_path(points: List[Point], row_tolerance: float = 2.0):
    """
    Create a logical snake-like path through a grid.
    """

    rows = organize_into_rows(points, row_tolerance)

    # Sort rows top-to-bottom
    rows.sort(key=lambda row: sum(p[1] for p in row) / len(row))

    path = []

    for i, row in enumerate(rows):

        # Sort row left-to-right
        row_sorted = sorted(row, key=lambda p: p[0])

        # Reverse every other row
        if i % 2 == 1:
            row_sorted.reverse()

        path.extend(row_sorted)

    return path


